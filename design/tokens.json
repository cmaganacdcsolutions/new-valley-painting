      "blue-800": "#1e3a8a",
      "teal-700": "#11698c"
    },
    "feedback": {
      "success-700": "#15803d",
      "success-50": "#f0fdf4",
      "error-700": "#b91c1c",
      "error-50": "#fef2f2",
      "warning-700": "#b45309",
      "warning-50": "#fffbeb",
      "info-700": "{color.legacy.teal-700}",
      "info-50": "#e8f3f7"
    },

    "bg": {
      "page": "{color.gray.0}",
      "subtle": "{color.gray.50}",
      "muted": "{color.gray.100}",
      "dark": "{color.navy.950}",
      "dark-raised": "{color.navy.900}",
      "dark-hover": "{color.navy.800}",
      "accent": "{color.orange.600}",
      "accent-soft": "{color.orange.50}"
    },
    "text": {
      "default": "{color.gray.900}",
      "strong": "{color.navy.950}",
      "body": "{color.gray.700}",
      "muted": "{color.gray.600}",
      "subtle": "{color.gray.500}",
      "on-dark": "{color.gray.0}",
      "on-dark-muted": "{color.gray.300}",
      "on-dark-subtle": "{color.gray.400}",
      "on-accent": "{color.navy.950}",
      "accent-on-light": "{color.orange.700}",
      "accent-on-dark": "{color.orange.500}",
      "link": "{color.orange.700}",
      "link-hover": "{color.orange.800}",
      "error": "{color.feedback.error-700}",
      "success": "{color.feedback.success-700}"
    },
    "border": {
      "subtle": "{color.gray.200}",
      "default": "{color.gray.300}",
      "input": "{color.gray.500}",
      "input-hover": "{color.gray.700}",
      "input-focus": "{color.navy.950}",
      "on-dark": "{color.navy.700}",
      "accent": "{color.orange.600}",
      "error": "{color.feedback.error-700}"
    },
    "icon": {
      "accent": "{color.orange.600}",
      "accent-on-light-text": "{color.orange.700}",
      "on-dark": "{color.orange.500}",
      "default": "{color.navy.950}",
      "muted": "{color.gray.500}"
    },
    "focus": {
      "ring": "{color.orange.600}",
      "ring-on-accent": "{color.navy.950}"
    },
    "star": "{color.orange.500}"
  },

  "contrast": [
    { "fg": "#111827", "bg": "#ffffff", "ratio": 17.74, "use": "Body/heading text on white", "wcag": "AAA" },
    { "fg": "#374151", "bg": "#ffffff", "ratio": 10.31, "use": "Body copy on white", "wcag": "AAA" },
    { "fg": "#4b5563", "bg": "#ffffff", "ratio": 7.56, "use": "Muted text, captions", "wcag": "AAA" },
    { "fg": "#6b7280", "bg": "#ffffff", "ratio": 4.83, "use": "Placeholder, subtle text, input border (UI 3:1)", "wcag": "AA" },
    { "fg": "#6b7280", "bg": "#f9fafb", "ratio": 4.63, "use": "Subtle text on subtle bg", "wcag": "AA" },
    { "fg": "#0b1a33", "bg": "#ffffff", "ratio": 17.36, "use": "Headings (strong) on white", "wcag": "AAA" },
    { "fg": "#ffffff", "bg": "#0b1a33", "ratio": 17.36, "use": "Text on header/hero/footer", "wcag": "AAA" },
    { "fg": "#d1d5db", "bg": "#0b1a33", "ratio": 11.78, "use": "Muted text on dark", "wcag": "AAA" },
    { "fg": "#9ca3af", "bg": "#0b1a33", "ratio": 6.84, "use": "Subtle text on dark (footer legal)", "wcag": "AA" },
    { "fg": "#ffffff", "bg": "#10233f", "ratio": 15.74, "use": "Text on drawer / dark cards", "wcag": "AAA" },
    { "fg": "#d1d5db", "bg": "#10233f", "ratio": 10.68, "use": "Muted text on dark cards", "wcag": "AAA" },
    { "fg": "#ffffff", "bg": "#183156", "ratio": 13.02, "use": "Text on dark hover surface", "wcag": "AAA" },
    { "fg": "#f97316", "bg": "#0b1a33", "ratio": 6.19, "use": "Accent text/kicker/stat numbers on dark", "wcag": "AA" },
    { "fg": "#f97316", "bg": "#10233f", "ratio": 5.62, "use": "Accent text on dark cards", "wcag": "AA" },
    { "fg": "#0b1a33", "bg": "#ea580c", "ratio": 4.88, "use": "PRIMARY BUTTON label on brand orange; text in orange CTA band", "wcag": "AA" },
    { "fg": "#0b1a33", "bg": "#f97316", "ratio": 6.19, "use": "Primary button label, hover state", "wcag": "AA" },
    { "fg": "#ea580c", "bg": "#0b1a33", "ratio": 4.88, "use": "Brand orange text on navy (allowed), focus ring on dark", "wcag": "AA" },
    { "fg": "#c2410c", "bg": "#ffffff", "ratio": 5.18, "use": "Accent text, links, kickers on white", "wcag": "AA" },
    { "fg": "#c2410c", "bg": "#f9fafb", "ratio": 4.96, "use": "Accent text on subtle bg", "wcag": "AA" },
    { "fg": "#c2410c", "bg": "#fff7ed", "ratio": 4.58, "use": "Accent text on accent-soft bg", "wcag": "AA" },
    { "fg": "#ea580c", "bg": "#ffffff", "ratio": 3.56, "use": "NON-TEXT ONLY: icons, rules, focus ring, borders, large display text >=24px", "wcag": "AA-large/UI only" },
    { "fg": "#ffffff", "bg": "#ea580c", "ratio": 3.56, "use": "PROHIBITED for text under 24px regular / 18.66px bold. Do not put white labels on orange.", "wcag": "FAIL (normal text)" },
    { "fg": "#ea580c", "bg": "#f9fafb", "ratio": 3.41, "use": "Focus ring on subtle bg (UI 3:1)", "wcag": "UI" },
    { "fg": "#b91c1c", "bg": "#ffffff", "ratio": 6.47, "use": "Error text/border", "wcag": "AA" },
    { "fg": "#15803d", "bg": "#ffffff", "ratio": 5.02, "use": "Success text", "wcag": "AA" },
    { "fg": "#b45309", "bg": "#ffffff", "ratio": 5.02, "use": "Warning text", "wcag": "AA" },
    { "fg": "#11698c", "bg": "#ffffff", "ratio": 6.13, "use": "Info text", "wcag": "AA" },
    { "fg": "#4b5563", "bg": "#d1d5db", "ratio": 5.08, "use": "Disabled button label on disabled fill", "wcag": "AA" }
  ],

  "font-family": {
