{
  "meta": {
    "name": "New Valley Painting — Design Tokens",
    "version": "1.0.0",
    "date": "2026-11-02",
    "owner": "senior-uiux-design (CDC Software Solutions)",
    "naming": "Every leaf becomes a CSS custom property by joining its path with '-': color.navy.950 -> --color-navy-950; font-size.h2 -> --font-size-h2; easing.out-expo -> --easing-out-expo. Values that start with '{' are aliases to another token path. tokens.css mirrors this file 1:1. The Concept Board 'Especificaciones' page must use the same names.",
    "fluid-basis": "Fluid clamp() values interpolate linearly between a 360px and a 1440px viewport (1rem = 16px)."
  },

  "color": {
    "navy": {
      "950": "#0b1a33",
      "900": "#10233f",
      "800": "#183156",
      "700": "#2a3d5c"
    },
    "orange": {
      "50": "#fff7ed",
      "100": "#ffedd5",
      "500": "#f97316",
      "600": "#ea580c",
      "700": "#c2410c",
      "800": "#9a3412"
    },
    "gray": {
      "0": "#ffffff",
      "50": "#f9fafb",
      "100": "#f3f4f6",
      "200": "#e5e7eb",
      "300": "#d1d5db",
      "400": "#9ca3af",
      "500": "#6b7280",
      "600": "#4b5563",
      "700": "#374151",
      "800": "#1f2937",
      "900": "#111827"
