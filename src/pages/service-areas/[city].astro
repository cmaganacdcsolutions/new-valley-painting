---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import Faq from '../../components/Faq.astro';
import FinalCta from '../../components/FinalCta.astro';
import BeforeAfterSlider from '../../components/BeforeAfterSlider.astro';
import ReviewCards from '../../components/ReviewCards.astro';
import { abs, SITE } from '../../lib/site';
import { breadcrumbList, faqPage, cityNode, providerRef, graph } from '../../lib/jsonld';
import { services, cities, cityFaqs, type City } from '../../data/content';
import heroImg from '../../assets/stock/img-01-hero.jpg';
import '../../styles/sections.css';
import '../../styles/pages.css';

export function getStaticPaths() {
  return cities.map((city) => ({ params: { city: city.slug }, props: { city } }));
}
interface Props { city: City }
const { city: c } = Astro.props;
const path = `/service-areas/${c.slug}/`;
const faqs = cityFaqs(c);
const others = cities.filter((x) => x.slug !== c.slug);
const title = `Painters & Remodelers in ${c.name}, NC | New Valley Painting`;
const description = `Family-owned painting and remodeling in ${c.name}, NC. Interior and exterior painting, kitchens, baths, flooring and more. Fully insured, 2-year warranty. Free estimates.`;
const jsonLd = graph([
  {
    '@type': 'Service',
    '@id': `${abs(path)}#service`,
    name: `Painting & Remodeling in ${c.name}, NC`,
    serviceType: 'Painting and remodeling',
    description,
    url: abs(path),
    provider: providerRef,
    areaServed: cityNode(c.name),
  },
  breadcrumbList([{ name: 'Home', path: '/' }, { name: 'Service Areas', path: '/service-areas/' }, { name: c.name, path }]),
  faqPage(faqs),
]);
---
<Base title={title} description={description} path={path} jsonLd={jsonLd}>
  <PageHero
    variant="dark"
    kicker={`Serving ${c.name} & nearby`}
    h1={`Painters & Remodelers in ${c.name}, NC`}
    lead={`Painting and remodeling for ${c.name} homes, inside and out. Family owned, fully insured and backed by a 2-year workmanship warranty.`}
    image={heroImg}
    alt="Bright living room with freshly painted walls and white built-in shelves"
    crumbs={[{ name: 'Home', href: '/' }, { name: 'Service Areas', href: '/service-areas/' }, { name: c.name }]}
  />
  <TrustStrip />

  <section class="section" aria-labelledby="intro-title">
    <div class="container city-intro">
      <div class="city-intro__head" data-reveal>
        <p class="kicker">{c.name}, NC</p>
        <h2 id="intro-title">Painting &amp; Remodeling in {c.name}</h2>
      </div>
      <div class="city-intro__body" data-reveal>
        <p class="city-intro__lead">{c.intro}</p>
        <p>We're family owned and fully insured, and every project is backed by our 2-year workmanship warranty.</p>
        <a class="link-arrow city-intro__call" href={SITE.phoneHref}>Call {SITE.phone} <Icon name="arrow-right" size={18} /></a>
      </div>
    </div>
  </section>

  <section class="section section--subtle" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="kicker">What we do</p>
        <h2 id="services-title">Our Services in {c.name}</h2>
        <p class="section-head__lead">One trusted, family-owned team for the inside and outside of your home.</p>
      </div>
      <ul class="mini-grid mini-grid--city" data-reveal-group>
        {services.map((s) => (
          <li>
            <a class="mini-card" href={`/services/${s.slug}/`}>
              <Image class="mini-card__media" src={s.image} alt="" width={96} height={96} format="webp" quality={65} loading="lazy" decoding="async" />
              <span class="mini-card__body">
                <span class="mini-card__title">{s.name}</span>
                {s.confirm && <span class="ph-chip" data-placeholder="true">To confirm</span>}
              </span>
              <Icon name="chevron-right" size={20} class="mini-card__chev" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="ba-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="kicker">Before &amp; after</p>
        <h2 id="ba-title">See the Transformation</h2>
        <p class="section-head__lead">Same house, new curb appeal. Drag the slider to compare.</p>
      </div>
      <div class="ba">
        <figure class="ba__fig" data-reveal>
          <BeforeAfterSlider />
          <figcaption class="ba__caption" data-placeholder="true">Exterior brick painting · Raleigh-Durham area <span class="ph-chip" data-placeholder="true">To confirm</span></figcaption>
        </figure>
        <div class="ba__copy" data-reveal>
          <h3>Painted brick, crisp black trim</h3>
          <p>A dated tan brick exterior turned bright white with black window trim and fresh white details. That's the kind of change a professional exterior paint job makes.</p>
          <div class="ba__actions">
            <a class="link-arrow" href="/projects/">View more projects <Icon name="arrow-right" size={18} /></a>
            <a class="btn btn--primary" href="/free-estimate/">Get a Free Estimate <Icon name="arrow-right" size={20} class="btn__arrow" /></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--subtle" aria-labelledby="reviews-title">
    <div class="container">
      <div class="section-head section-head--center" data-reveal>
        <p class="kicker">Reviews</p>
        <h2 id="reviews-title">What Homeowners Say</h2>
      </div>
      <ReviewCards />
    </div>
  </section>

  <Faq faqs={faqs} title={`Questions from ${c.name} Homeowners`} />

  <section class="section section--dark nearby" aria-labelledby="nearby-title">
    <div class="container nearby__grid">
      <div class="nearby__head" data-reveal>
        <p class="kicker">Nearby areas</p>
        <h2 id="nearby-title">Also Serving Towns Near {c.name}</h2>
        <p>Don't see your town? Call us, and we'll let you know if we can help. <a class="nearby__phone" href={SITE.phoneHref}>{SITE.phone}</a></p>
      </div>
      <div class="nearby__list" data-reveal>
        <ul class="nearby__chips">
          {others.map((o) => <li><a class="nearby__chip" href={`/service-areas/${o.slug}/`}><Icon name="map-pin" size={20} class="nearby__pin" /><span>{o.name}</span><Icon name="chevron-right" size={16} class="nearby__chev" /></a></li>)}
        </ul>
        <p class="nearby__note" data-placeholder="true"><span class="ph-chip ph-chip--dark" data-placeholder="true">To confirm</span>Coverage area to be confirmed by New Valley Painting.</p>
      </div>
    </div>
  </section>

  <FinalCta />
</Base>
