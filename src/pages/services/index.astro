---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import ServiceGrid from '../../components/ServiceGrid.astro';
import Steps from '../../components/Steps.astro';
import FinalCta from '../../components/FinalCta.astro';
import { abs } from '../../lib/site';
import { breadcrumbList, graph } from '../../lib/jsonld';
import { services } from '../../data/content';
import heroImg from '../../assets/stock/img-05-kitchen-hub.jpg';
import '../../styles/sections.css';
import '../../styles/pages.css';

const title = 'Painting & Remodeling Services in Raleigh-Durham, NC | New Valley Painting';
const description = 'Interior and exterior painting, cabinet painting, kitchen and bathroom remodeling, flooring, drywall and decks in Raleigh-Durham, NC. Free estimates.';
const jsonLd = graph([
  { '@type': 'CollectionPage', '@id': `${abs('/services/')}#webpage`, url: abs('/services/'), name: 'Painting & Remodeling Services', description },
  breadcrumbList([{ name: 'Home', path: '/' }, { name: 'Services', path: '/services/' }]),
  {
    '@type': 'ItemList',
    itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(`/services/${s.slug}/`), name: s.name })),
  },
]);
---
<Base title={title} description={description} path="/services/" jsonLd={jsonLd}>
  <PageHero
    variant="light"
    h1="Painting & Remodeling Services in Raleigh-Durham"
    lead="One trusted, family-owned team for the inside and outside of your home, from a fresh coat of paint to a complete remodel."
    image={heroImg}
    alt="Bright kitchen with freshly painted cabinets and clean finishes"
    crumbs={[{ name: 'Home', href: '/' }, { name: 'Services' }]}
  />
  <TrustStrip />
  <section class="section" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="kicker">What we do</p>
        <h2 id="services-title">Our Services</h2>
        <p class="section-head__lead">Choose a service to see what's included and how we work.</p>
      </div>
      <ServiceGrid />
    </div>
  </section>
  <Steps />
  <FinalCta />
</Base>
