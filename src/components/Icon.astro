---
import { icons, type IconName } from '../lib/icons';
interface Props { name: IconName; size?: number; class?: string; strokeWidth?: number }
const { name, size = 24, class: cls, strokeWidth = 2 } = Astro.props;
const filled = name === 'star-filled';
---
{filled
  ? <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true" focusable="false" class={cls} set:html={icons[name]} />
  : <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class={cls} set:html={icons[name]} />}
